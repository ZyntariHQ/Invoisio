      "NotificationPreferencesDto": {
        "type": "object",
        "properties": {
          "pushNotificationsEnabled": {
            "type": "boolean",
            "description": "Whether the authenticated user has opted in to receiving push notifications.",
            "example": true
          },
          "registeredPushTokensCount": {
            "type": "number",
            "description": "Number of Expo push tokens currently registered for this user on any device. Zero means no device has registered a token yet; notifications will be skipped.",
            "example": 2
          },
          "preferenceExplicit": {
            "type": "boolean",
            "description": "True when the backend was able to read an explicit saved preference. False when the user record was missing/legacy and this response falls back to the documented schema default. Consumers can use this flag to tell whether a first-run settings dialog should be shown.",
            "example": true
          },
          "contractVersion": {
            "type": "string",
            "description": "Semantic contract version for this response shape. Clients may key parsing logic on this string.",
            "example": "1.0.0"
          }
        },
