{
  "name": "@invoisio/soroban-client",
  "version": "1.0.0",
  "type": "module",
  "description": "Soroban invoice-payment contract client helper library for Invoisio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "example:record": "ts-node -r dotenv/config examples/record-payment.ts",
    "example:query": "ts-node -r dotenv/config examples/query-payment.ts",
    "example:config": "ts-node -r dotenv/config examples/query-config.ts",
    "generate": "stellar contract bindings typescript --wasm ../target/wasm32-unknown-unknown/release/invoice_payment.wasm --output-dir ./src/generated --overwrite"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
